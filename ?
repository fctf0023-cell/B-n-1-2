local flyConn, flyGyro, flyVel
createMinecraftToggle(tab2, "🕊️ Bay Lượn Tự Do (Fly Hack)", 44, function(state)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if state and root then
        flyGyro = Instance.new("BodyGyro", root)
        flyGyro.P = 9e4
        flyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
        flyVel = Instance.new("BodyVelocity", root)
        flyVel.Velocity = Vector3.new(0, 0, 0)
        flyVel.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        
        flyConn = RunService.RenderStepped:Connect(function()
            flyGyro.CFrame = Camera.CFrame
            local moveV = Vector3.new()
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveV = moveV + Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveV = moveV - Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveV = moveV - Camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveV = moveV + Camera.CFrame.RightVector end
            flyVel.Velocity = moveV * 50
        end)
    else
        if flyConn then flyConn:Disconnect() flyConn = nil end
        if flyGyro then flyGyro:Destroy() flyGyro = nil end
        if flyVel then flyVel:Destroy() flyVel = nil end
    end
end)

