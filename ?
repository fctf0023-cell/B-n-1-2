local function makeKey(text, kc, pos, isColorS)
    local b = Instance.new("TextButton", pcGui)
    b.Size = UDim2.new(0, 42, 0, 42)
    b.Position = pos
    b.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
    b.BorderColor3 = Color3.fromRGB(0, 255, 120)
    b.TextColor3 = Color3.fromRGB(0, 255, 120)
    b.TextSize = 14
    b.Font = Enum.Font.GothamBold
    b.Text = text
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
    
    b.MouseButton1Down:Connect(function()
        if isColorS then
            b.BackgroundColor3 = Color3.fromRGB(255, 0, 120)
        else
            b.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
        end
        b.TextColor3 = Color3.fromRGB(255, 255, 255)
        VirtualInputManager:SendKeyEvent(true, kc, false, game)
    end)
    b.MouseButton1Up:Connect(function()
        b.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
        b.TextColor3 = Color3.fromRGB(0, 255, 120)
        VirtualInputManager:SendKeyEvent(false, kc, false, game)
    end)
end

