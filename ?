local function createTabButton(text, index, targetTab)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -16, 0, 34)
    btn.Position = UDim2.new(0, 8, 0, 8 + (index - 1) * 40)
    btn.BackgroundColor3 = Color3.fromRGB(18, 18, 28)
    btn.TextColor3 = Color3.fromRGB(180, 180, 200)
    btn.TextSize = 11
    btn.Font = Enum.Font.GothamBold
    btn.Text = text
    btn.Parent = Sidebar
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

    btn.MouseButton1Click:Connect(function()
        for _, t in pairs(Container:GetChildren()) do t.Visible = false end
        for _, b in pairs(Sidebar:GetChildren()) do
            if b:IsA("TextButton") then
                b.BackgroundColor3 = Color3.fromRGB(18, 18, 28)
                b.TextColor3 = Color3.fromRGB(180, 180, 200)
            end
        end
        targetTab.Visible = true
        btn.BackgroundColor3 = Color3.fromRGB(0, 255, 120)
        btn.TextColor3 = Color3.fromRGB(10, 10, 16)
    end)
    
    if index == 1 then
        targetTab.Visible = true
        btn.BackgroundColor3 = Color3.fromRGB(0, 255, 120)
        btn.TextColor3 = Color3.fromRGB(10, 10, 16)
    end
end

